#Accept a number from user and check if this element is present in the list or not ,also tell how many times it is present in the list

li = [10,20,30,10,60,20,30,10,50,]
num = int(input('Enter the number:'))
count = li.count(num)

if count > 0:
    print(f'{num} is present in list {count} times.')
else:
    print(f'{num} is not present in list.')